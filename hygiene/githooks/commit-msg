# hygiene/install_hooks.sh points core.hooksPath here, so the checker is
# found from this file rather than from the working directory.
hook_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
checker="$hook_dir/../check_commit_msg.py"

[ -x "$checker" ] || exit 0
exec "$checker" "$1"
